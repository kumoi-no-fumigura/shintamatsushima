 ],
 "poems": [
  {
   "seq": "1",
   "text": "千年へむ陰といはひて玉だれの神代にたもり松をうゑけむ",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "峰たか〓たかくさふとき此寺のみのりやつぐる入相のあゑ",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "鷲のをの山の白雪みほとけの世にふり玄ける花とこそ見め",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "夕玄ぐれふれどぬれせぬ名も玄るき山の松笠我にかさなむ",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "一しほの色おぞ見ゆる秋山のなかに名におふ谷のもみぢ葉",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "春雨のふるといすれど綠なほあさヾは小野の下もえのいろ",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "人とはぬむぐらのかどの明方に霞みてひとりむかふ月かげ",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "ゆきやらでなグめぞわたす八橋のくもでにかゝる靑柳の糸",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "折れバをし折らでも梅の玄みろへる袖の匂を家づとにせむ",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "み山りいをう比松りさをしもなど梢にきえぬ春の玄らゆき",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "かきわけて尋ぬるも猶春を淺みわか菜いまれの荻のやけ原",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "花おそき春をわぶらし鶯のゆきのふる巢にこゑのものうき",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "心ある海士の苦屋の夕日かげいり江のにしにかすむ鳥やま",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "小松原あまた千年の見ゆる野お袖ひきつれて子日してまし",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "よもにたつ春の日ながらわきて猶光のどけき玉つ玄まやま",
   "kana": "",
   "speaker": "",
   "page": 37,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "み山いでて猶玄のびねふ子規なくやふもとの森の木がくれ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "よるも見む光をそへよ久方の中にかふてふさとのうのはな",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "わか楓みどりにそよぐ朝風にもみぢの秋のいろもおもはず",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "ゆく春のふるさとゝなるみ吉野も大川のベハ藤なみのはな",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "山吹の枝もたわゝにさく花のふくむや露のたまがは比さと",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "玄ほならぬ水口いづこ住の江の波よる岸も小田のなはしろ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "いとゆふのあそぶ日かげの夕雲雀みどりの空に聲も落家る",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "ふく風をうしとも玄らぞさそはるゝ花の心のいかに幼なき",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "老が身の思ひたゝれぬ山路をも花に忘れてけふいこえぬる",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "里とほき山櫻戶もあけてまし花見がてらにひともとふやと",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "花見てぞ更に樂しむよもの風をさまる御代の春にあふ身を",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "春毎にみし色としも思ひあへずけさ開けぬる花いめづらし",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "かへる雁なごりをとめよ山のはに月もいさよふ春〓明ぼの",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "おとも今朝いせの濱〓ほにいでて秋を忍ばぬ浦かぜぞふく",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "ふくからに暑さゑられぬ飛鳥風なつや昨日の淵となるらむ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "夕日かげこがくれつゝもなく蟬の聲もすヾしき森の下かぜ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "鳴神もそれかとばかり雨雲のよそに聞ゆるゆふだちのそら",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "ぬきみだる玉とみえつゝとぶ螢ひかりを流すたきの白いと",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "中がきのひまもりきつゝ蚊遣火をたかぬ宿おも烟いぶせき",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "さらでだに短き夜はをあかず見る月おいいとゞあとぞともなき",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "とふ人の道たえはてヽ我やどを忘るゝ艸やなほ玄げるらむ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": ".つまこふる秋に增りて照射する峯のをじがや物おもふらむ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "雲はらふ風きこゆなり五月雨の雨よりほか比音せさりしを",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "ちぎりにし袖のなごりや橘の小じまに今もさきにほふらむ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "菖蒲かるさ月きぬれバ池水のそこに見えにし影ものこらず",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "ひと聲をわすれグさ〓の時鳥あかで行方のそこと玄られぬ",
   "kana": "",
   "speaker": "",
   "page": 38,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "おしなべて氷るかは瀨の水鳥いくがにまどへる思をやする",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "むつまじなみつの友よりとも千鳥ひとりねられぬ曉のこゑ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "玉すだれ猶やかゝげむ雪の上にざえまさりぬる峯の月かげ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "あかの水いかにくむらむ山寺のかけひも今朝い氷ゐにけり",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "常なしとうき世を見する湊江のわか葉なりしも芦の冬グれ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "おく霜も松のひまをやもりぬらむなべていかれぬ森比下艸",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "末葉より雫とをけてむら竹のひま〓〓白くのこるあさしも",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "音羽山おとに聞えてあふ坂のあらしのかぜにちる木葉かな",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "ぬきつゝも笹わけし朝の袖の上ふ猶露そへて時雨ふるらし",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "よしちらバ散かひ曇れむら紅葉くれゆく秋の道やまがふと",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "幾たびか心をそむるけふも我ゆきゝ比岡の木々のもみぢ葉",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "おく露の霜となるまで日數へて狗さかり見る園の玄らぎく",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "とび渡るかげさへ見えて澤水のあさけ靜けき鴫のはねおと",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "柴舟のあとの玄ら波さちかくれゆくへも見えぬ宇治の川霧",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "波よするもまの浦風さそふらしたゞこゝもとに衣うつこゑ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "入方をかなじくをしむ人もなき片山ざとのあき比夜のつき",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "かつらぎの神も契やたがふらむよるとも見えぬつきの光に",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "月の中のかつらも秋の露玄げみ詠むる袖のぬれむとすらむ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "浪花江やかれゆく芦の秋比霜にそヾろ寒くも月ぞうつろふ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "心あての山の木間におもかげいさし出る月比猶ぞつれなき",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "ふる里を世のうきおてn荒さじ比心もよわる秋比ゆふぐれ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "秋ふかき露をかなしぶ虫のねよさらでもぬらもくさの袂を",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "たちまじりなくなる鹿の淚ふやそめて門田のいねの色こき",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "ありときく天の浮橋くもわけてわたりや來ぬる秋のはつ雁",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "誰をかくおもひ入野の花すゝきほさで露けき袖とみゆらむ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "玉川の水にかよへるあきやとき萩のはつ花かげもめづらし",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "我ながら恨むいはかなみる夢をさめよとてやハ〓のさよ風",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "あけやらぬ天の岩戶の關もがな棚機つめをとめてかへさじ",
   "kana": "",
   "speaker": "",
   "page": 39,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "山がつも松にゆづり葉をりそへて年と共おやゆき歸るらむ",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "をの山のいづれの木々かもれぬべきこりて炭やく峯の烟に",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "かりくらし宿かも人もならゑばのなきぬ野邊にや草枕せむ",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "東路にはやむる駒もとめてましはつ雪うもき關のすぎむら",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "さゆる夜も苦い衣にかさならず岩やの床ぞあかしかねつる",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "くれゆけバ道の考るべと見つゝこし木高き松も音ばかりする",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "老らくい願ふ佛にともし火をかゝぐる外の身のわざもなし",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "誰か又みはてぬ夢を我しむらむひとりおどろく鳥比聲かい",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "始より末かけてとい思はじと見しに違はぬはてぞかなしき",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "今ぞゑるなき名をたてヽ恨としも絕なむとてのかおとむりとい",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "かたみとておきし扇の移り香も只身を焦すつまとなりぬる",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "たのめしを誠なしとい徒にとしへてのちぞおもひ去りぬる",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "あやなくもけふの狹布はつ〓〓に見し人ゆゑや詠め暮さむ",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "蘆邊より荻につたへてふく風のみぬ面影のいかお身にしむ",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "きてぞ見むもらも涙のあま衣たみのゝ島の名あもかくれび",
   "kana": "",
   "speaker": "",
   "page": 40,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "大名むち少名彥なの神代よりひさしき國とつくりおきけむ",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "學びえぬもろこしの文やまと歌みちいかた〓〓心ざせとも",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "月北いろ花の香めでし樂し〓もなべて昔のはるの夜のゆめ",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "永き夜をわびてあかしの泊舟うきね比袖もなみさわぐらし",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "かりまくら結ぶ夢路もみじか夜の月の都いみるほどもなし",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "かりそめに亥ばしと結ぶ柴の庵朽ていくたび造りかへけむ",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "早き瀨のそまの筏士さも棹のそでのひまなき身の業やうき",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "雨になほみち急ぐなり柴人のやもらふ花のかげやなからむ",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "白雲もうき世に通ふ道とぢし谷のとぼそいされかすむらむ",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "うちなびく蘆の葉分の濱風にかりゐしたづ比見え隱れする",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "い今い老筆になり殊此頃寒天手龜し而筆傾く書直し進度いへ共不得",
   "kana": "",
   "speaker": "",
   "page": 41,
   "pid": "993386",
   "form": "短歌",
   "genre": ""
  }
